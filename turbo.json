{
  "tasks": {
    "clean": {
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "build": {
      "outputs": ["dist/**", ".next/**"],
      "cache": false,
      "dependsOn": ["^build"]
    },
    "go-aura#build": {
      "outputs": ["dist/**"]
    },
    "aura-design-decisions#build": {
      "outputs": ["dist/**"],
      "dependsOn": ["go-aura#build"]
    },
    "aura-storybook#build": {
      "outputs": ["storybook-static/**"],
      "dependsOn": ["go-aura#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}
