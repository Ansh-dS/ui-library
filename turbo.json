{
  "tasks": {
    "lint": {
      "cache": true
    },
    "build": {
      "outputs": ["dist/**", ".next/**"],
      "cache": false,
      "dependsOn": ["^build"]
    },
    "cli#build": {
      "outputs": ["dist/**"]
    },
    "aurajet#build": {
      "outputs": ["dist/**"],
      "dependsOn": ["cli#build"]
    },
    "design-decisions#build": {
      "outputs": ["dist/**"],

      "dependsOn": ["aurajet#build"]
    },
    "storybook#build": {
      "outputs": ["storybook-static/**"],
      "dependsOn": ["aurajet#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}
