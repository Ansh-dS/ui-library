{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "exactOptionalPropertyTypes": false,
    /*
    why do we don't want to produce any file(like .js , .d.ts etc)?
       this is development tool end user never need the code.
    */
    "noEmit": true,

    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    ".storybook",
    "../server/components/**/*",
    "../server/hooks/**/*"
  ]
}
