{
  "name": "aura-ui",
  "private": "false",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/ui.cjs",
  "module": "./dist/ui.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aura": "./bin/aura-init.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./tally.css": "./src/styles/tally.css",
    "./riverside.css": "./src/styles/riverside.css",
    "./global.css": "./src/styles/global.css"
  },
  "files": [
    "bin",
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "vite build && pnpm postbuild",
    "postbuild": "cp ../../global.css src/styles/global.css",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "eslint": "^9.39.2",
    "lucide-react": "^1.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.3",
    "inquirer": "^13.3.0",
    "clsx": "^2.1.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/browser-playwright": "^4.0.18",
    "tailwind-merge": "^3.4.0"
  }
}
