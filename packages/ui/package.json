{
  "name": "components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/ui.cjs",
  "module": "./dist/ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./token.css": "./styles/token.css",
    "./global.css": "./styles/global.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "vite build && pnpm postbuild",
    "postbuild": "cp ../../global.css styles/global.css && cp ../../token.css styles/token.css",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "eslint": "^9.39.2",
    "lucide-react": "^1.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/browser-playwright": "^4.0.18",
    "tailwind-merge": "^3.4.0"
  }
}
